// Some example tasks for common languages.
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug active Python file",
    "adapter": "Debugpy",
    "program": "$ZED_FILE",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Debug active JavaScript file",
    "adapter": "JavaScript",
    "program": "$ZED_FILE",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "type": "pwa-node",
  },
  {
    "label": "JavaScript debug terminal",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "type": "pwa-node",
  },
  {
    "label": "Debug active Ada main (gdb)",
    "adapter": "GNAT",
    "program": "$ZED_GNAT_MAIN",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "stopOnEntry": false,
    "preLaunchTask": "gprbuild",
  },
  {
    "label": "Attach to running Ada process (gdb)",
    "adapter": "GNAT",
    "request": "attach",
    "pid": "${command:pickProcess}",
  },
  {
    "label": "Debug active Ada main (codelldb, macOS aarch64)",
    "adapter": "codelldb",
    "program": "$ZED_GNAT_MAIN",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "preLaunchTask": "gprbuild",
    "sourceLanguages": ["ada", "c", "cpp"],
  },
]
