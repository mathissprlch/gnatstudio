// Zed GNAT settings
//
// This file is your editable user settings. The Ada/SPARK defaults live in
// the bundled extension and the read-only `default settings`. Run
// `zed: open default settings` from the command palette (cmd-shift-p) to
// browse them.
//
// Anything you put here overrides the defaults. For ALS, GNATprove and
// RecordFlux specific configuration, see the comments below.
{
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  // Show SPARK proof results inline next to the line they relate to.
  "diagnostics": {
    "inline": { "enabled": true, "padding": 6 },
  },
