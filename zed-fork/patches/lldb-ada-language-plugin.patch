+
+#include "AdaLanguage.h"
+#include "lldb/Core/Address.h"
+#include "lldb/Core/PluginManager.h"
+#include "lldb/Core/ValueObject.h"
+#include "lldb/DataFormatters/StringPrinter.h"
+#include "lldb/DataFormatters/TypeSummary.h"
+#include "lldb/Symbol/CompilerType.h"
+#include "lldb/Target/Process.h"
+#include "lldb/Target/Target.h"
+#include "lldb/Utility/DataBufferHeap.h"
+#include "lldb/Utility/DataExtractor.h"
+#include "lldb/Utility/Status.h"
+#include "lldb/Utility/Stream.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/Threading.h"
+
+using namespace lldb;
+using namespace lldb_private;
+using namespace lldb_private::formatters;
+
+LLDB_PLUGIN_DEFINE(AdaLanguage)
+
+void AdaLanguage::Initialize() {
+  PluginManager::RegisterPlugin(GetPluginNameStatic(), "Ada Language",
+                                CreateInstance);
+}
+
+void AdaLanguage::Terminate() { PluginManager::UnregisterPlugin(CreateInstance); }
+
+Language *AdaLanguage::CreateInstance(lldb::LanguageType language) {
+  switch (language) {
+  case eLanguageTypeAda83:
+  case eLanguageTypeAda95:
+  case eLanguageTypeAda2005:
+  case eLanguageTypeAda2012:
+    return new AdaLanguage();
+  default:
+    return nullptr;
+  }
+}
+
+bool AdaLanguage::IsSourceFile(llvm::StringRef file_path) const {
+  return file_path.ends_with(".adb") || file_path.ends_with(".ads");
+}
+
+namespace {
+
+// GNAT represents an unconstrained array (e.g. String) as a "fat pointer"
+// record carrying two members: P_ARRAY (a pointer to the element data) and
+// P_BOUNDS (a pointer to a {LB0, UB0} bounds record). Match that shape,
+// restricted to single-byte character elements so non-character unconstrained
+// arrays fall through to the default (struct) rendering unchanged.
+bool IsAdaStringFatPointer(ValueObject &valobj) {
+  ValueObjectSP array_sp = valobj.GetChildMemberWithName("P_ARRAY");
+  ValueObjectSP bounds_sp = valobj.GetChildMemberWithName("P_BOUNDS");
+  if (!array_sp || !bounds_sp)
+    return false;
+  CompilerType element;
+  if (!array_sp->GetCompilerType().GetPointeeType().IsArrayType(&element))
+    return false;
+  return element.IsCharType();
+}
+
+bool AdaStringSummaryProvider(ValueObject &valobj, Stream &stream,
+                             const TypeSummaryOptions &options) {
+  ValueObjectSP array_sp = valobj.GetChildMemberWithName("P_ARRAY");
+  ValueObjectSP bounds_sp = valobj.GetChildMemberWithName("P_BOUNDS");
+  if (!array_sp || !bounds_sp)
+    return false;
+
+  addr_t data_addr = array_sp->GetValueAsUnsigned(LLDB_INVALID_ADDRESS);
+  if (data_addr == 0 || data_addr == LLDB_INVALID_ADDRESS)
+    return false;
+
+  Status error;
+  ValueObjectSP bounds = bounds_sp->Dereference(error);
+  if (!bounds || error.Fail())
+    return false;
+  ValueObjectSP lb_sp = bounds->GetChildMemberWithName("LB0");
+  ValueObjectSP ub_sp = bounds->GetChildMemberWithName("UB0");
+  if (!lb_sp || !ub_sp)
+    return false;
+
+  // Ada arrays use a language-defined lower bound; length is UB - LB + 1.
+  int64_t lb = lb_sp->GetValueAsSigned(1);
+  int64_t ub = ub_sp->GetValueAsSigned(0);
+  if (ub < lb) {
+    stream.PutCString("\"\"");
+    return true;
+  }
+  uint64_t length = static_cast<uint64_t>(ub - lb + 1);
+
+  TargetSP target_sp = valobj.GetTargetSP();
+  ProcessSP process_sp = valobj.GetProcessSP();
+  if (!target_sp || !process_sp)
+    return false;
+
+  // An Ada String is a fixed-length, non-NUL-terminated buffer, so read the
+  // exact bytes and render them via the buffer path (the ASCII *string* path
+  // assumes C-string semantics and would drop the last character).
+  bool uncapped =
+      options.GetCapping() == TypeSummaryCapping::eTypeSummaryUncapped;
+  uint64_t max_size = target_sp->GetMaximumSizeOfStringSummary();
+  bool truncated = false;
+  if (!uncapped && length > max_size) {
+    length = max_size;
+    truncated = true;
+  }
+
+  WritableDataBufferSP buffer_sp(new DataBufferHeap(length, 0));
+  Status read_error;
+  process_sp->ReadMemory(data_addr, buffer_sp->GetBytes(), length, read_error);
+  if (read_error.Fail())
+    return false;
+
+  StringPrinter::ReadBufferAndDumpToStreamOptions sopts(valobj);
+  sopts.SetData(DataExtractor(buffer_sp,
+                              target_sp->GetArchitecture().GetByteOrder(),
+                              target_sp->GetArchitecture().GetAddressByteSize()));
+  sopts.SetStream(&stream);
+  sopts.SetQuote('"');
+  sopts.SetSourceSize(static_cast<uint32_t>(length));
+  sopts.SetBinaryZeroIsTerminator(false);
+  sopts.SetIsTruncated(truncated);
+  return StringPrinter::ReadBufferAndDumpToStream<
+      StringPrinter::StringElementType::ASCII>(sopts);
+}
+
+// A constrained Ada String is a fixed-length array of Character stored inline
+// (no fat pointer), e.g. `Name : String := "Ada"`. Match an array of
+// single-byte character elements so it renders as a quoted string; arrays of
+// any other element type fall through to the default element-by-element
+// rendering unchanged.
+bool IsAdaCharArray(ValueObject &valobj) {
+  CompilerType element;
+  return valobj.GetCompilerType().IsArrayType(&element) && element.IsCharType();
+}
+
+bool AdaCharArraySummaryProvider(ValueObject &valobj, Stream &stream,
+                                 const TypeSummaryOptions &options) {
+  if (!IsAdaCharArray(valobj))
+    return false;
+
+  DataExtractor data;
+  Status error;
+  valobj.GetData(data, error);
+  if (error.Fail())
+    return false;
+
+  uint64_t length = data.GetByteSize();
+  TargetSP target_sp = valobj.GetTargetSP();
+  if (!target_sp)
+    return false;
+
+  bool uncapped =
+      options.GetCapping() == TypeSummaryCapping::eTypeSummaryUncapped;
+  bool truncated = false;
+  uint64_t max_size = target_sp->GetMaximumSizeOfStringSummary();
+  if (!uncapped && length > max_size) {
+    length = max_size;
+    truncated = true;
+  }
+
+  StringPrinter::ReadBufferAndDumpToStreamOptions sopts(valobj);
+  sopts.SetData(DataExtractor(data, 0, length));
+  sopts.SetStream(&stream);
+  sopts.SetQuote('"');
+  sopts.SetSourceSize(static_cast<uint32_t>(length));
+  sopts.SetBinaryZeroIsTerminator(false);
+  sopts.SetIsTruncated(truncated);
+  return StringPrinter::ReadBufferAndDumpToStream<
+      StringPrinter::StringElementType::ASCII>(sopts);
+}
+
+} // namespace
+
+HardcodedFormatters::HardcodedSummaryFinder
+AdaLanguage::GetHardcodedSummaries() {
+  static llvm::once_flag g_initialize;
+  static HardcodedFormatters::HardcodedSummaryFinder g_formatters;
+
+  llvm::call_once(g_initialize, []() -> void {
+    g_formatters.push_back(
+        [](ValueObject &valobj, lldb::DynamicValueType,
+           FormatManager &) -> TypeSummaryImpl::SharedPointer {
+          static CXXFunctionSummaryFormat::SharedPointer formatter_sp(
+              new CXXFunctionSummaryFormat(
+                  TypeSummaryImpl::Flags().SetCascades(true).SetDontShowChildren(
+                      true),
+                  AdaStringSummaryProvider, "Ada string summary provider"));
+          if (IsAdaStringFatPointer(valobj))
+            return formatter_sp;
+          return nullptr;
+        });
+    g_formatters.push_back(
+        [](ValueObject &valobj, lldb::DynamicValueType,
+           FormatManager &) -> TypeSummaryImpl::SharedPointer {
+          static CXXFunctionSummaryFormat::SharedPointer formatter_sp(
+              new CXXFunctionSummaryFormat(
+                  TypeSummaryImpl::Flags().SetCascades(true).SetDontShowChildren(
+                      true),
+                  AdaCharArraySummaryProvider,
+                  "Ada character array summary provider"));
+          if (IsAdaCharArray(valobj))
+            return formatter_sp;
+          return nullptr;
+        });
+  });
+
+  return g_formatters;
+}
