+//===-- TypeSystemAda.h ---------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLDB_SOURCE_PLUGINS_TYPESYSTEM_ADA_TYPESYSTEMADA_H
+#define LLDB_SOURCE_PLUGINS_TYPESYSTEM_ADA_TYPESYSTEMADA_H
+
+#include "Plugins/TypeSystem/Clang/TypeSystemClang.h"
+
+namespace lldb_private {
+
+/// A type system for Ada.
+///
+/// GNAT emits standard DWARF whose core type model (scalars, records,
+/// constrained arrays, enumerations, access types) maps cleanly onto the Clang
+/// AST, so TypeSystemAda is built on top of TypeSystemClang and reuses its
+/// machinery. What it adds is a native Ada identity: GetMinimumLanguage()
+/// reports eLanguageTypeAda*, so values flow through the AdaLanguage data
+/// formatters directly rather than being bridged through the C/C++ formatter
+/// categories.
+///
+/// This is the foundation for Ada-native behavior that the Clang type model
+/// cannot represent (variant records, true array index bounds, tagged-type
+/// dynamic dispatch, fixed-point scaling).
+class TypeSystemAda : public TypeSystemClang {
+  // LLVM RTTI support
+  static char ID;
+
+public:
+  // LLVM casting support. A TypeSystemAda is also a TypeSystemClang, so it
+  // answers to both type IDs.
+  bool isA(const void *ClassID) const override {
+    return ClassID == &ID || TypeSystemClang::isA(ClassID);
+  }
+  static bool classof(const TypeSystem *ts) { return ts->isA(&ID); }
+
+  TypeSystemAda(llvm::StringRef name, llvm::Triple triple)
+      : TypeSystemClang(name, triple) {}
+
+  ~TypeSystemAda() override = default;
+
+  // PluginInterface functions
+  llvm::StringRef GetPluginName() override { return GetPluginNameStatic(); }
+
+  static llvm::StringRef GetPluginNameStatic() { return "ada"; }
+
+  static lldb::TypeSystemSP CreateInstance(lldb::LanguageType language,
+                                           Module *module, Target *target);
+
+  static LanguageSet GetSupportedLanguagesForTypes();
+  static LanguageSet GetSupportedLanguagesForExpressions();
+
+  static void Initialize();
+
+  static void Terminate();
+
+  /// Every type owned by this type system is an Ada type.
+  lldb::LanguageType
+  GetMinimumLanguage(lldb::opaque_compiler_type_t type) override;
+
+  /// Render GNAT's mangled names with Ada syntax (e.g. "pkg__type" as
+  /// "Pkg.Type") for display. Display-only; GetTypeName (used for lookups) is
+  /// left untouched.
+  ConstString GetDisplayTypeName(lldb::opaque_compiler_type_t type) override;
+};
+
+} // namespace lldb_private
+
+#endif // LLDB_SOURCE_PLUGINS_TYPESYSTEM_ADA_TYPESYSTEMADA_H
