+//===-- TypeSystemAda.cpp -------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "TypeSystemAda.h"
+
+#include "lldb/Core/Module.h"
+#include "lldb/Core/PluginManager.h"
+#include "lldb/Target/Target.h"
+#include "lldb/Utility/ArchSpec.h"
+#include "lldb/Utility/ConstString.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/ADT/StringRef.h"
+
+#include <string>
+
+using namespace lldb;
+using namespace lldb_private;
+
+LLDB_PLUGIN_DEFINE(TypeSystemAda)
+
+char TypeSystemAda::ID = 0;
+
+static bool IsAdaLanguage(lldb::LanguageType language) {
+  switch (language) {
+  case eLanguageTypeAda83:
+  case eLanguageTypeAda95:
+  case eLanguageTypeAda2005:
+  case eLanguageTypeAda2012:
+    return true;
+  default:
+    return false;
+  }
+}
+
+lldb::TypeSystemSP TypeSystemAda::CreateInstance(lldb::LanguageType language,
+                                                 Module *module,
+                                                 Target *target) {
+  if (!IsAdaLanguage(language))
+    return lldb::TypeSystemSP();
+
+  ArchSpec arch;
+  if (module)
+    arch = module->GetArchitecture();
+  else if (target)
+    arch = target->GetArchitecture();
+
+  if (!arch.IsValid())
+    return lldb::TypeSystemSP();
+
+  llvm::Triple triple = arch.GetTriple();
+  // LLVM wants this to be set to iOS or MacOSX; if we're working on a
+  // bare-boards type image, change the triple for llvm's benefit (mirrors
+  // TypeSystemClang::CreateInstance).
+  if (triple.getVendor() == llvm::Triple::Apple &&
+      triple.getOS() == llvm::Triple::UnknownOS) {
+    if (triple.getArch() == llvm::Triple::arm ||
+        triple.getArch() == llvm::Triple::aarch64 ||
+        triple.getArch() == llvm::Triple::aarch64_32 ||
+        triple.getArch() == llvm::Triple::thumb) {
+      triple.setOS(llvm::Triple::IOS);
+    } else {
+      triple.setOS(llvm::Triple::MacOSX);
+    }
+  }
+
+  // Ada types are read from a module's DWARF. The target-scoped scratch type
+  // system exists for expression evaluation, which Ada does not support yet
+  // (see GetSupportedLanguagesForExpressions), so only the module case is
+  // handled here.
+  if (module) {
+    std::string ast_name =
+        "Ada ASTContext for '" + module->GetFileSpec().GetPath() + "'";
+    return std::make_shared<TypeSystemAda>(ast_name, triple);
+  }
+  return lldb::TypeSystemSP();
+}
+
+LanguageSet TypeSystemAda::GetSupportedLanguagesForTypes() {
+  LanguageSet languages;
+  languages.Insert(lldb::eLanguageTypeAda83);
+  languages.Insert(lldb::eLanguageTypeAda95);
+  languages.Insert(lldb::eLanguageTypeAda2005);
+  languages.Insert(lldb::eLanguageTypeAda2012);
+  return languages;
+}
+
+LanguageSet TypeSystemAda::GetSupportedLanguagesForExpressions() {
+  // Ada expression evaluation is not supported yet.
+  return LanguageSet();
+}
+
+void TypeSystemAda::Initialize() {
+  PluginManager::RegisterPlugin(
+      GetPluginNameStatic(), "Ada type system", CreateInstance,
+      GetSupportedLanguagesForTypes(), GetSupportedLanguagesForExpressions());
+}
+
+void TypeSystemAda::Terminate() {
+  PluginManager::UnregisterPlugin(CreateInstance);
+}
+
+lldb::LanguageType
+TypeSystemAda::GetMinimumLanguage(lldb::opaque_compiler_type_t type) {
+  return lldb::eLanguageTypeAda95;
+}
+
+// GNAT mangles Ada names with "__" as the package separator (e.g.
+// "shapes__color") and lowercases everything. For each identifier token that
+// looks like such a mangled name, render the "." separator and Ada's
+// Mixed_Case ("Shapes.Color"); leave everything else (C/Clang qualifiers like
+// "const", punctuation such as '*'/'&'/'[]') untouched, so a qualified type
+// like "const shapes__shape" becomes "const Shapes.Shape".
+static ConstString AdaifyTypeName(ConstString clang_name) {
+  llvm::StringRef name = clang_name.GetStringRef();
+  if (!name.contains("__"))
+    return clang_name;
+
+  auto is_ident = [](char c) { return llvm::isAlnum(c) || c == '_'; };
+
+  std::string out;
+  out.reserve(name.size());
+  for (size_t i = 0, n = name.size(); i < n;) {
+    if (!is_ident(name[i])) {
+      out.push_back(name[i++]);
+      continue;
+    }
+    size_t start = i;
+    while (i < n && is_ident(name[i]))
+      ++i;
+    llvm::StringRef tok = name.substr(start, i - start);
+    if (!tok.contains("__")) {
+      out += tok; // not a mangled Ada name (e.g. "const", "char")
+      continue;
+    }
+    bool at_word_start = true;
+    for (size_t k = 0, m = tok.size(); k < m; ++k) {
+      if (tok[k] == '_' && k + 1 < m && tok[k + 1] == '_') {
+        out.push_back('.');
+        at_word_start = true;
+        ++k; // consume the second '_'
+        continue;
+      }
+      char c = tok[k];
+      if (at_word_start && llvm::isAlpha(c))
+        c = llvm::toUpper(c);
+      out.push_back(c);
+      at_word_start = (tok[k] == '_');
+    }
+  }
+  return ConstString(out);
+}
+
+ConstString
+TypeSystemAda::GetDisplayTypeName(lldb::opaque_compiler_type_t type) {
+  return AdaifyTypeName(TypeSystemClang::GetDisplayTypeName(type));
+}
