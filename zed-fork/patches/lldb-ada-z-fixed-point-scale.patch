# M2 step 2: render Ada fixed-point with the actual scaled value.
#
# Builds on lldb-ada-fixed-point.patch (which made *_fixed types resolve to
# their underlying integer so the variable would render at all -- as the raw
# stored int, e.g. `bf = 40`, `m = 1999`). This step plumbs the DWARF scale
# (DW_AT_binary_scale or DW_AT_decimal_scale) and adds an AdaLanguage summary
# that multiplies the raw int by 2^binary_scale or 10^decimal_scale to display
# the real value (`bf = 2.5`, `m = 19.99`).
#
# Key design choice: lldb's Clang AST deduplicates builtin integers (one
# ShortTy/IntTy/LongLongTy singleton per AST context), so we cannot key the
# scale on the underlying integer's QualType without polluting plain
# Short_Integer / Long_Long_Integer values. The fix is to wrap each fixed-point
# base in its own Clang typedef (named after the GNAT base type), giving it a
# unique QualType that the scale map can key on cleanly.
#
# Files touched:
#   - ParsedDWARFTypeAttributes: two std::optional<int64_t> fields for the
#     scale, populated in its ctor when DW_AT_binary_scale / DW_AT_decimal_scale
#     appears.
#   - DWARFASTParserClang base_type case: when the encoding is *_fixed and the
#     type system is TypeSystemAda, wrap clang_type in CreateTypedef and record
#     the scale on the typedef's opaque QualType.
#   - TypeSystemAda: FixedPointScale struct + RecordFixedPointScale /
#     GetFixedPointScale backed by a DenseMap<opaque_compiler_type_t, ...>.
#   - AdaLanguage::GetHardcodedSummaries: a new matcher that walks the
#     CompilerType's typedef chain (one hop at a time -- canonical would skip
#     past the fixed-point typedef back to bare short/int) and applies the
#     scale to the raw signed value.
#
# Named with a "z" prefix so it sorts last in the patches glob -- it depends on
# both lldb-ada-typesystem-ada.patch (creates TypeSystemAda) and
# lldb-ada-language-plugin.patch (creates AdaLanguage).
diff --git a/lldb/source/Plugins/Language/Ada/AdaLanguage.cpp b/lldb/source/Plugins/Language/Ada/AdaLanguage.cpp
index fe0323bf0..00409402c 100644
--- a/lldb/source/Plugins/Language/Ada/AdaLanguage.cpp
+++ b/lldb/source/Plugins/Language/Ada/AdaLanguage.cpp
@@ -7,6 +7,7 @@
 //===----------------------------------------------------------------------===//
 
 #include "AdaLanguage.h"
+#include "Plugins/TypeSystem/Ada/TypeSystemAda.h"
 #include "lldb/Core/Address.h"
 #include "lldb/Core/PluginManager.h"
 #include "lldb/Core/ValueObject.h"
@@ -22,6 +23,9 @@
 #include "llvm/ADT/StringRef.h"
 #include "llvm/Support/Threading.h"
 
+#include <cmath>
+#include <optional>
+
 using namespace lldb;
 using namespace lldb_private;
 using namespace lldb_private::formatters;
@@ -180,6 +184,50 @@ bool AdaCharArraySummaryProvider(ValueObject &valobj, Stream &stream,
       StringPrinter::StringElementType::ASCII>(sopts);
 }
 
+// Walk the value's type one Clang-typedef hop at a time looking for an Ada
+// fixed-point scale recorded by DWARFASTParserClang. The scale lives on the
+// per-base-type typedef the parser wraps around the underlying integer (see
+// DWARFASTParserClang base_type case). The variable's own type may be a
+// subrange typedef on top of that, so walk down via GetTypedefedType rather
+// than canonicalizing (canonical would skip straight to the bare short/int and
+// lose the recorded scale).
+static std::optional<TypeSystemAda::FixedPointScale>
+GetAdaFixedPointScale(ValueObject &valobj) {
+  CompilerType ct = valobj.GetCompilerType();
+  if (!ct.IsValid())
+    return std::nullopt;
+  auto ts = ct.GetTypeSystem();
+  auto *ts_ada = ts.dyn_cast_or_null<TypeSystemAda>();
+  if (!ts_ada)
+    return std::nullopt;
+  while (ct.IsValid()) {
+    if (auto s = ts_ada->GetFixedPointScale(ct.GetOpaqueQualType()))
+      return s;
+    CompilerType next = ct.GetTypedefedType();
+    if (!next.IsValid() ||
+        next.GetOpaqueQualType() == ct.GetOpaqueQualType())
+      break;
+    ct = next;
+  }
+  return std::nullopt;
+}
+
+bool AdaFixedPointSummaryProvider(ValueObject &valobj, Stream &stream,
+                                  const TypeSummaryOptions &) {
+  auto scale = GetAdaFixedPointScale(valobj);
+  if (!scale)
+    return false;
+  Status err;
+  int64_t raw = valobj.GetValueAsSigned(0, &err);
+  if (err.Fail())
+    return false;
+  double scaled = static_cast<double>(raw) *
+                  std::pow(scale->decimal ? 10.0 : 2.0,
+                           static_cast<double>(scale->exponent));
+  stream.Printf("%g", scaled);
+  return true;
+}
+
 } // namespace
 
 HardcodedFormatters::HardcodedSummaryFinder
@@ -213,6 +261,19 @@ AdaLanguage::GetHardcodedSummaries() {
             return formatter_sp;
           return nullptr;
         });
+    g_formatters.push_back(
+        [](ValueObject &valobj, lldb::DynamicValueType,
+           FormatManager &) -> TypeSummaryImpl::SharedPointer {
+          static CXXFunctionSummaryFormat::SharedPointer formatter_sp(
+              new CXXFunctionSummaryFormat(
+                  TypeSummaryImpl::Flags().SetCascades(true).SetDontShowChildren(
+                      true),
+                  AdaFixedPointSummaryProvider,
+                  "Ada fixed-point summary provider"));
+          if (GetAdaFixedPointScale(valobj))
+            return formatter_sp;
+          return nullptr;
+        });
   });
 
   return g_formatters;
