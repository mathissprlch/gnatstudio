       byte_stride = form_value.Unsigned();
       break;
 
+    // Ada fixed-point (GNAT -fgnat-encodings=minimal): captured so the
+    // base-type parse below can hand the scale to TypeSystemAda.
+    case DW_AT_binary_scale:
+      binary_scale = form_value.Signed();
+      break;
+
+    case DW_AT_decimal_scale:
+      decimal_scale = form_value.Signed();
+      break;
+
     case DW_AT_calling_convention:
       calling_convention = form_value.Unsigned();
       break;
@@ -677,6 +688,37 @@ DWARFASTParserClang::ParseTypeModifier(const SymbolContext &sc,
     clang_type = m_ast.GetBuiltinTypeForDWARFEncodingAndBitSize(
         attrs.name.GetStringRef(), attrs.encoding,
         attrs.byte_size.value_or(0) * 8);
+    // Ada fixed-point: lldb has no fixed-point type, so the encoding was just
+    // resolved to its underlying integer (via the lldb-ada-fixed-point.patch
+    // fall-through). Wrap that integer in a Clang typedef named after the
+    // DWARF base type so this fixed-point type has its own unique QualType --
+    // without the typedef, every variable of the same bit width would alias
+    // the shared ShortTy/IntTy/LongLongTy singleton and the formatter could
+    // not distinguish a Bin_Fixed from a plain Short_Integer. Record the
+    // DW_AT_binary_scale / DW_AT_decimal_scale on that QualType for the
+    // AdaLanguage formatter to apply at render time.
+    if (clang_type && (attrs.encoding == llvm::dwarf::DW_ATE_signed_fixed ||
+                       attrs.encoding == llvm::dwarf::DW_ATE_unsigned_fixed) &&
+        !attrs.name.IsEmpty()) {
+      if (auto *ts_ada = llvm::dyn_cast<TypeSystemAda>(&m_ast)) {
+        CompilerType typedef_type = m_ast.CreateTypedef(
+            clang_type.GetOpaqueQualType(), attrs.name.AsCString(),
+            CompilerDeclContext(), 0);
+        if (typedef_type.IsValid()) {
+          clang_type = typedef_type;
+          if (attrs.binary_scale)
+            ts_ada->RecordFixedPointScale(
+                clang_type.GetOpaqueQualType(),
+                {/*decimal=*/false,
+                 static_cast<int32_t>(*attrs.binary_scale)});
+          else if (attrs.decimal_scale)
+            ts_ada->RecordFixedPointScale(
+                clang_type.GetOpaqueQualType(),
+                {/*decimal=*/true,
+                 static_cast<int32_t>(*attrs.decimal_scale)});
+        }
+      }
+    }
     break;
 
   case DW_TAG_pointer_type:
