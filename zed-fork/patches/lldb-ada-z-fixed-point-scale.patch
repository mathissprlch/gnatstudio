 }
+
+void TypeSystemAda::RecordFixedPointScale(
+    lldb::opaque_compiler_type_t type, FixedPointScale scale) {
+  m_fixed_point_scales[type] = scale;
+}
+
+std::optional<TypeSystemAda::FixedPointScale>
+TypeSystemAda::GetFixedPointScale(
+    lldb::opaque_compiler_type_t type) const {
+  auto it = m_fixed_point_scales.find(type);
+  if (it == m_fixed_point_scales.end())
+    return std::nullopt;
+  return it->second;
+}
