diff --git a/lldb/source/Plugins/TypeSystem/Clang/TypeSystemClang.cpp b/lldb/source/Plugins/TypeSystem/Clang/TypeSystemClang.cpp
index f70efe5ed..4c7a81931 100644
--- a/lldb/source/Plugins/TypeSystem/Clang/TypeSystemClang.cpp
+++ b/lldb/source/Plugins/TypeSystem/Clang/TypeSystemClang.cpp
@@ -115,7 +115,13 @@ TypeSystemClangSupportsLanguage(lldb::LanguageType language) {
          // Use Clang for D until there is a proper language plugin for it
          language == eLanguageTypeD ||
          // Open Dylan compiler debug info is designed to be Clang-compatible
-         language == eLanguageTypeDylan;
+         language == eLanguageTypeDylan ||
+         // Use Clang for Ada until there is a proper language plugin for it.
+         // GNAT emits standard DWARF tags (base/structure/array/enumeration/
+         // pointer types) that DWARFASTParserClang can consume, which is enough
+         // for inspecting scalars, records and constrained arrays.
+         language == eLanguageTypeAda83 || language == eLanguageTypeAda95 ||
+         language == eLanguageTypeAda2005 || language == eLanguageTypeAda2012;
 }
 
 // Checks whether m1 is an overload of m2 (as opposed to an override). This is
@@ -572,6 +578,13 @@ LanguageSet TypeSystemClang::GetSupportedLanguagesForTypes() {
   languages.Insert(lldb::eLanguageTypeC_plus_plus_14);
   languages.Insert(lldb::eLanguageTypeC_plus_plus_17);
   languages.Insert(lldb::eLanguageTypeC_plus_plus_20);
+  // Ada rides on the Clang type system for now (see
+  // TypeSystemClangSupportsLanguage); only types are supported, not
+  // expression evaluation.
+  languages.Insert(lldb::eLanguageTypeAda83);
+  languages.Insert(lldb::eLanguageTypeAda95);
+  languages.Insert(lldb::eLanguageTypeAda2005);
+  languages.Insert(lldb::eLanguageTypeAda2012);
   return languages;
 }
 
